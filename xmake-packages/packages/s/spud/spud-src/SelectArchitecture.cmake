# Downstream packaging only. Keep host detection separate from explicit target.
function(spud_select_architecture out_var processor apple_arch)
    if(NOT "${apple_arch}" STREQUAL "")
        set(selected "${apple_arch}")
    else()
        set(selected "${processor}")
    endif()
    string(TOLOWER "${selected}" selected)
    if(selected STREQUAL "arm64" OR selected STREQUAL "aarch64")
        set(${out_var} arm64 PARENT_SCOPE)
    elseif(selected STREQUAL "x86_64" OR selected STREQUAL "amd64" OR selected STREQUAL "x64")
        set(${out_var} x86_64 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "SPUD requires one supported target architecture; got '${selected}'")
    endif()
endfunction()
