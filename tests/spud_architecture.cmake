include("${CMAKE_CURRENT_LIST_DIR}/../xmake-packages/packages/s/spud/spud-src/SelectArchitecture.cmake")
if(DEFINED REFUSE_TARGET)
    spud_select_architecture(actual arm64 "${REFUSE_TARGET}")
    message(FATAL_ERROR "Unsupported architecture unexpectedly admitted")
endif()
function(check processor apple expected)
    spud_select_architecture(actual "${processor}" "${apple}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${processor}/${apple}: expected ${expected}, got ${actual}")
    endif()
endfunction()
check(arm64 "" arm64)
check(AMD64 "" x86_64)
check(aarch64 "" arm64)
check(arm64 x86_64 x86_64)
check(x86_64 arm64 arm64)
check(arm64 arm64 arm64)
check(x86_64 x86_64 x86_64)
message(STATUS "SPUD target architecture selection passed")
