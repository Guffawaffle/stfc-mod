# Local security/privacy handoffs; not public docs.
docs/HOTKEY_TRACE_PRIVACY_HANDOFF.md

# Generated Info.plist files (generated from templates)
**/Info.plist
mods/.xmake

# Project-local AXF workspace and generated manifests are repo-owned.
!axf.workspace.json
!manifests/
!manifests/**

# Public AX facade is tracked; the private AX repo stays local-only.
!.ax/
!.ax/**
.ax/agent-worktrees/
.ax-priv/

# Local background-agent per-worktree briefs.
.agent-worktree/

# LexRunner local overlay and runtime artifacts.
.smartergpt.local/
.smartergpt/runner/

# Windows launcher local build and package outputs.
windows-launcher/**/bin/
windows-launcher/**/obj/
windows-launcher/artifacts/
