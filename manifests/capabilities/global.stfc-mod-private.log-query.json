{
  "manifestVersion": "axf/v0",
  "id": "global.stfc-mod-private.log-query",
  "summary": "High-signal log query with profiles, excludes, counts, and bounded results",
  "provider": "stfc",
  "adapterType": "cli",
  "executionTarget": {
    "launcher": {
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File"
      ]
    },
    "target": {
      "path": ".ax/ax.ps1",
      "relativeTo": "workspace"
    },
    "args": [
      "log-query"
    ]
  },
  "argsSchema": {
    "type": "object",
    "properties": {
      "profile": {
        "type": "string"
      },
      "pattern": {
        "type": "string"
      },
      "exclude-pattern": {
        "type": "string"
      },
      "all": {
        "type": "boolean"
      },
      "last": {
        "type": "integer"
      },
      "max-results": {
        "type": "integer"
      },
      "include-known": {
        "type": "boolean"
      },
      "case-sensitive": {
        "type": "boolean"
      },
      "summary": {
        "type": "boolean"
      },
      "text-only": {
        "type": "boolean"
      },
      "raw": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "outputModes": [
    "json"
  ],
  "sideEffects": "read",
  "scope": "global",
  "lifecycleState": "active",
  "defaults": {},
  "policies": [
    "require_workspace_binding"
  ],
  "owner": "module:stfc",
  "argMap": {
    "profile": "-Profile",
    "pattern": "-Pattern",
    "exclude-pattern": "-ExcludePattern",
    "all": "-All",
    "last": "-Last",
    "max-results": "-MaxResults",
    "include-known": "-IncludeKnown",
    "case-sensitive": "-CaseSensitive",
    "summary": "-Summary",
    "text-only": "-TextOnly",
    "raw": "-Raw"
  },
  "warnings": [
    "Reads local game/mod logs. Treat output as potentially sensitive unless redaction is explicitly verified.",
    "Read-only does not mean output-safe; do not auto-run without user approval."
  ],
  "details": []
}
