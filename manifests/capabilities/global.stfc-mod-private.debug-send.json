{
  "manifestVersion": "axf/v0",
  "id": "global.stfc-mod-private.debug-send",
  "summary": "Send one live JSON debug command to the running game and wait for the response",
  "provider": "stfc",
  "adapterType": "cli",
  "executionTarget": {
    "launcher": {
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File"
      ]
    },
    "target": {
      "path": ".ax/ax.ps1",
      "relativeTo": "workspace"
    },
    "args": [
      "debug-send"
    ]
  },
  "argsSchema": {
    "type": "object",
    "properties": {
      "cmd": {
        "type": "string"
      },
      "json": {
        "type": "string"
      },
      "timeout-sec": {
        "type": "integer"
      },
      "poll-ms": {
        "type": "integer"
      }
    },
    "additionalProperties": false
  },
  "outputModes": [
    "json"
  ],
  "sideEffects": "unknown",
  "scope": "global",
  "lifecycleState": "active",
  "defaults": {},
  "policies": [
    "require_workspace_binding"
  ],
  "owner": "module:stfc",
  "argMap": {
    "cmd": "-Cmd",
    "json": "-Json",
    "timeout-sec": "-TimeoutSec",
    "poll-ms": "-PollMs"
  },
  "warnings": [
    "Side effects are request-dependent and may mutate live game/mod state.",
    "Requires a running game with live debug enabled. Do not use for passive inspection; use ax debug-send --help instead."
  ],
  "details": [
    "Sends an arbitrary request through the live debug channel exposed by the running mod.",
    "Use for explicit live-debug workflows where the requested command and expected effect are understood."
  ],
  "examples": [
    "ax debug-send -Cmd recentEvents",
    "ax debug-send -Json '{\"cmd\":\"recentEvents\",\"last\":10}'"
  ]
}
