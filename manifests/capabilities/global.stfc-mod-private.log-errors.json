{
  "manifestVersion": "axf/v0",
  "id": "global.stfc-mod-private.log-errors",
  "summary": "Show error and warning lines from the log",
  "provider": "stfc",
  "adapterType": "cli",
  "executionTarget": {
    "launcher": {
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File"
      ]
    },
    "target": {
      "path": ".ax/ax.ps1",
      "relativeTo": "workspace"
    },
    "args": [
      "log-errors"
    ]
  },
  "argsSchema": {
    "type": "object",
    "properties": {
      "last": {
        "type": "integer"
      },
      "all": {
        "type": "boolean"
      },
      "raw": {
        "type": "boolean"
      },
      "text-only": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "outputModes": [
    "json"
  ],
  "sideEffects": "read",
  "scope": "global",
  "lifecycleState": "active",
  "defaults": {},
  "policies": [
    "require_workspace_binding"
  ],
  "owner": "module:stfc",
  "argMap": {
    "last": "-Last",
    "all": "-All",
    "raw": "-Raw",
    "text-only": "-TextOnly"
  },
  "warnings": [
    "Reads local game/mod logs. Treat output as potentially sensitive unless redaction is explicitly verified.",
    "Read-only does not mean output-safe; do not auto-run without user approval."
  ],
  "details": [],
  "examples": []
}
